# ============================================
# VARIABLES DE ENTORNO - ABOGADA LANDING PAGE
# ============================================
# Este archivo documenta todas las variables de entorno necesarias
# para ejecutar el proyecto. Copia este archivo a .env y completa
# los valores según tu configuración.

# ============================================
# SUPABASE CONFIGURATION (REQUERIDO)
# ============================================
# URL de tu proyecto Supabase
# Obtener en: https://app.supabase.com/project/_/settings/api
# Formato: https://[tu-proyecto-id].supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública) de Supabase
# Obtener en: https://app.supabase.com/project/_/settings/api
# Esta clave es segura para usar en el frontend y backend
# Nota: Para operaciones admin, considera usar SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=tu-anon-key-aqui

# ============================================
# BACKEND CONFIGURATION
# ============================================
# Clave secreta para proteger el endpoint GET /api/leads
# Genera una clave segura aleatoria (mínimo 20 caracteres)
# Ejemplo: openssl rand -base64 32
# REQUERIDO en producción para proteger acceso a los leads
ADMIN_KEY=REEMPLAZA_CON_valor_de_openssl_rand_base64_32

# Puerto del servidor (solo para desarrollo local)
# En Vercel, el puerto se asigna automáticamente
# OPCIONAL - Default: 3000
PORT=3000

# Entorno de ejecución
# Valores: development | production | test
# OPCIONAL - Default: development
NODE_ENV=development

# ============================================
# CORS CONFIGURATION (REQUERIDO EN PRODUCCIÓN)
# ============================================
# Origen(es) permitido(s) para peticiones CORS
# 
# En DESARROLLO:
#   - Si está vacío, se permite automáticamente localhost:8080
#   - No es necesario configurarlo para desarrollo local
#
# En PRODUCCIÓN:
#   - DEBE especificarse el dominio de tu frontend en Vercel
#   - Ejemplo: CORS_ORIGIN=https://tu-dominio.vercel.app
#   - Para múltiples orígenes, separar con comas (sin espacios):
#     CORS_ORIGIN=https://dominio1.com,https://dominio2.com
#
# REQUERIDO en producción, OPCIONAL en desarrollo
CORS_ORIGIN=

# ============================================
# VARIABLES OPCIONALES
# ============================================
# Las siguientes variables son opcionales y tienen valores por defecto

# Nivel de logging (futuro)
# LOG_LEVEL=info

# Rate limiting (futuro)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=15
